# Default notation cascade for views without nt:notations; copied from Catenary packages/rdf/notations/default.ttl.
# Draw marks, SHACL cards and pills, value sets and instance cards; class notation requires an explicit view choice.

@prefix nt:  <https://cristianvasquez.github.io/catenary/vocab/notation#> .
@prefix mkn: <https://cristianvasquez.github.io/catenary/vocab/notation/marks#> .
@prefix shn: <https://cristianvasquez.github.io/catenary/vocab/notation/shapes#> .
@prefix vsn: <https://cristianvasquez.github.io/catenary/vocab/notation/skos#> .
@prefix inn: <https://cristianvasquez.github.io/catenary/vocab/notation/instances#> .

nt:default nt:notations ( mkn:notation shn:notation vsn:notation inn:notation ) .
